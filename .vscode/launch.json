{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb debug ext) release",
            "type": "gdb",
            "request": "launch",
            "program": "${workspaceFolder}/bin/release/viterbi3",
            "args": ["config.json"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src",
            "env": {
                "LD_LIBRARY_PATH": "/opt/intel/oneapi/ipp/latest/lib/intel64:${env:LD_LIBRARY_PATH}"
            }
        },

        {
            "name": "(gdb) debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/debug/viterbi3",
            "preLaunchTask": "Compile Debug",
            "args": ["config.json"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src",
            "environment": [
                {"name": "LD_LIBRARY_PATH", "value": "/opt/intel/oneapi/ipp/latest/lib/intel64:${env:LD_LIBRARY_PATH}"}
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description":  "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
        ,
        {
            "name": "(gdb) release",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/release/viterbi3",
            "args": ["config.json"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/src",
            "environment": [
                {"name": "LD_LIBRARY_PATH", "value": "/opt/intel/oneapi/ipp/latest/lib/intel64:${env:LD_LIBRARY_PATH}"}
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description":  "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
        ,
        {
            "name": "(lldb) release",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/bin/release/viterbi3",
            "args": ["config.json"],
            "cwd": "${workspaceFolder}/src",
            "env": {
                "LD_LIBRARY_PATH": "/opt/intel/oneapi/ipp/latest/lib/intel64:${env:LD_LIBRARY_PATH}"
            }
        }

    ]
}